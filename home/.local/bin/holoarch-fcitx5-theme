#!/usr/bin/python3
"""Generate the opaque candidate background after Matugen updates its palette."""

import argparse
import configparser
import os
from pathlib import Path
import struct
import subprocess
import tempfile
import zlib


def rgb(value):
    if len(value) != 7 or not value.startswith("#"):
        raise ValueError("candidate background colors must use #RRGGBB")
    return bytes.fromhex(value[1:])


def chunk(kind, data):
    return (struct.pack(">I", len(data)) + kind + data
            + struct.pack(">I", zlib.crc32(kind + data)))


def background_png(background, border, width):
    # A wide center avoids the tiny generated pixmap's background artifacts in
    # WeChat's bundled Qt/Fcitx renderer. RGB PNG is opaque in every frontend.
    size = max(64, 2 * width + 8)
    rows = []
    for y in range(size):
        row = b"".join(
            border if min(x, y, size - 1 - x, size - 1 - y) < width
            else background for x in range(size)
        )
        rows.append(b"\0" + row)
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(b"".join(rows)))
            + chunk(b"IEND", b""))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--theme", type=Path, default=Path.home()
                        / ".local/share/fcitx5/themes/Matugen/theme.conf")
    parser.add_argument("--no-reload", action="store_true")
    args = parser.parse_args()
    theme = args.theme.expanduser()
    config = configparser.ConfigParser(interpolation=None)
    with theme.open() as stream:
        config.read_file(stream)
    panel = config["InputPanel/Background"]
    width = panel.getint("BorderWidth", fallback=0)
    if width < 0:
        raise ValueError("BorderWidth must be nonnegative")
    png = background_png(rgb(panel["Color"]), rgb(panel["BorderColor"]), width)
    image = theme.parent / "panel-background.png"
    if not image.exists() or image.read_bytes() != png:
        fd, temporary = tempfile.mkstemp(prefix=".panel-background-", dir=theme.parent)
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(png)
                os.fchmod(stream.fileno(), 0o644)
            os.replace(temporary, image)
        finally:
            Path(temporary).unlink(missing_ok=True)
        # Qt watches theme.conf, not the image: reload after publishing the
        # completed image, including when Matugen wrote the config first.
        os.utime(theme, None)
    if not args.no_reload:
        result = subprocess.run(["/usr/bin/fcitx5-remote", "--check", "-r"])
        if result.returncode not in (0, 1):
            raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
