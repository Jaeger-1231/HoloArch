#!/usr/bin/env bash

set -Eeuo pipefail

readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/holoarch-updates"
readonly CHECKER="$HOME/.config/waybar/scripts/holoarch-updates.sh"

info() { printf '\033[1;36m[HoloArch]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[HoloArch]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[HoloArch]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
HoloArch — Arch Linux 本地更新助手

用法：
  holoarch update   创建快照并更新 Pacman、AUR 和 Flatpak
  holoarch list     刷新并显示待更新项目
  holoarch refresh  刷新 Waybar 更新状态
  holoarch snapshot [说明]  为 root 和 home 创建 Snapper 快照
  holoarch help     显示帮助
EOF
}

admin_run() {
    if sudo -n true 2>/dev/null; then
        sudo "$@"
    elif [[ -t 0 && -t 1 ]]; then
        sudo "$@"
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    else
        die "当前没有可用的管理员授权方式。"
    fi
}

create_snapshots() {
    local description="${1:-holoarch-manual-$(date +%Y%m%d-%H%M%S)}"
    local config created=0

    command -v snapper >/dev/null 2>&1 || die "找不到 snapper。"
    [[ "$(findmnt -no FSTYPE / 2>/dev/null || true)" == "btrfs" ]] \
        || die "根文件系统不是 Btrfs，无法创建 Snapper 快照。"

    for config in root home; do
        if admin_run snapper -c "$config" get-config >/dev/null 2>&1; then
            info "创建 Snapper 快照 [$config]：$description"
            admin_run snapper -c "$config" create \
                --type single \
                --description "$description" \
                --cleanup-algorithm number
            ((created+=1))
        fi
    done
    (( created > 0 )) || die "没有找到可用的 root/home Snapper 配置。"
    info "已创建 $created 个快照。"
}

show_news() {
    command -v curl >/dev/null 2>&1 || return 0
    local titles
    titles=$(curl -fsSL --max-time 10 https://archlinux.org/feeds/news/ 2>/dev/null \
        | sed -n 's:.*<title>\([^<]*\)</title>.*:\1:p' \
        | sed '1d' \
        | head -n 5) || true
    if [[ -n "$titles" ]]; then
        info "最近的 Arch Linux 新闻："
        sed 's/^/  - /' <<< "$titles"
    else
        warn "未能读取 Arch Linux 新闻；更新仍保持交互模式。"
    fi
}

refresh_status() {
    [[ -x "$CHECKER" ]] || die "找不到更新检查器：$CHECKER"
    "$CHECKER" --once >/dev/null
}

print_source() {
    local label=$1 file=$2
    [[ -s "$file" ]] || return 0
    sed '/^[[:space:]]*$/d; s/^/['"$label"'] /' "$file"
}

list_updates() {
    [[ -x "$CHECKER" ]] || die "找不到更新检查器：$CHECKER"
    "$CHECKER" --once >/dev/null

    local output
    output=$(
        print_source Pacman  "$CACHE_DIR/repo.txt"
        print_source AUR     "$CACHE_DIR/aur.txt"
        print_source Flatpak "$CACHE_DIR/flatpak.txt"
    )

    if [[ -z "$output" ]]; then
        info "系统已是最新状态。"
        return 0
    fi

    printf '%s\n' "$output"
    if [[ -t 0 ]]; then
        printf '\n输入 u 开始更新，直接按 Enter 退出：'
        local choice=""
        read -r choice
        [[ "$choice" == "u" || "$choice" == "U" ]] && perform_update
    fi
}

needs_grub_refresh() {
    grep -Eq '^(grub|os-prober|mkinitcpio|amd-ucode|intel-ucode|linux|linux-lts|linux-zen|linux-hardened|linux-cachyos)[[:space:]]' <<< "$1"
}

postflight() {
    info "检查 pacman 数据库……"
    pacman -Dk

    if command -v dkms >/dev/null 2>&1; then
        info "DKMS 状态："
        dkms status || warn "DKMS 状态检查返回异常。"
    fi

    local failed_units
    failed_units=$(systemctl --failed --no-legend --no-pager 2>/dev/null || true)
    if [[ -n "$failed_units" ]]; then
        warn "存在失败的 systemd 服务："
        printf '%s\n' "$failed_units"
    else
        info "systemd 没有失败服务。"
    fi

    if command -v pacdiff >/dev/null 2>&1; then
        local pending_configs
        pending_configs=$(pacdiff -o 2>/dev/null || true)
        if [[ -n "$pending_configs" ]]; then
            warn "发现需要人工审阅的配置文件："
            printf '%s\n' "$pending_configs"
        fi
    fi
}

perform_update() {
    command -v pacman >/dev/null 2>&1 || die "找不到 pacman。"
    command -v sudo >/dev/null 2>&1 || die "找不到 sudo。"

    show_news

    local repo_updates="" repo_status=0
    set +e
    repo_updates=$(checkupdates)
    repo_status=$?
    set -e
    [[ $repo_status -eq 0 || $repo_status -eq 2 ]] \
        || die "无法读取官方仓库更新，请先检查网络和镜像。"

    info "请求管理员权限……"
    sudo -v

    if [[ "$(findmnt -no FSTYPE / 2>/dev/null || true)" == "btrfs" ]]; then
        create_snapshots "holoarch-before-$(date +%Y%m%d-%H%M%S)" \
            || die "快照创建失败，已停止更新。"
    fi

    info "更新 Arch 官方仓库……"
    sudo pacman -Syu

    if command -v paru >/dev/null 2>&1; then
        info "检查并审阅 AUR 更新（不查询 VCS 开发包远端）……"
        paru -Sua --review --nodevel
    else
        warn "未安装 paru，跳过 AUR。"
    fi

    if command -v flatpak >/dev/null 2>&1; then
        info "更新 Flatpak……"
        flatpak update
    fi

    if [[ -n "$repo_updates" ]] && needs_grub_refresh "$repo_updates"; then
        if command -v grub-mkconfig >/dev/null 2>&1; then
            info "检测到内核或引导相关更新，重新生成 GRUB 配置……"
            sudo grub-mkconfig -o /boot/grub/grub.cfg
        fi
    else
        info "没有引导相关更新，跳过 GRUB。"
    fi

    postflight
    refresh_status || warn "更新状态暂时无法刷新，Waybar 会自动重试。"

    if grep -Eq '^(linux|linux-lts|linux-zen|linux-hardened|linux-cachyos)[[:space:]]' <<< "$repo_updates"; then
        warn "内核已更新，建议完成工作后重启。"
    fi
    info "更新完成。"
}

case "${1:-help}" in
    update)  perform_update ;;
    list)    list_updates ;;
    refresh) refresh_status ;;
    snapshot)
        shift
        create_snapshots "${*:-holoarch-manual-$(date +%Y%m%d-%H%M%S)}"
        ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
esac
