#!/usr/bin/env bash

set -u

readonly GPU_MODE_PATH="/sys/class/platform-profile/platform-profile-0/device/gpu_mode"
readonly PLATFORM_PROFILE_PATH="/sys/firmware/acpi/platform_profile"
readonly NVIDIA_DRM_PATH="/sys/bus/pci/devices/0000:01:00.0/drm"
readonly ROOT_HELPER="/usr/local/libexec/holo-power-gpu"
readonly DESIRED_FILE="/var/lib/holo-power-mode/desired"
readonly DESIRED_GPU_FILE="/var/lib/holo-power-mode/desired-gpu"
readonly PENDING_REBOOT_FILE="/run/holo-power-mode/pending-reboot"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/holo-power-mode"
readonly FIREFOX_GPU_FILE="${CONFIG_DIR}/firefox-gpu"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
readonly LOCK_FILE="${RUNTIME_DIR}/holo-power-mode-${UID}.lock"

notify_user() {
    local urgency="$1"
    local title="$2"
    local message="$3"

    notify-send --app-name="Holo Power Mode" --urgency="$urgency" "$title" "$message" 2>/dev/null || true
}

run_powerprofilesctl() {
    /usr/bin/python3 /usr/bin/powerprofilesctl "$@"
}

read_power_profile() {
    local value

    if value="$(run_powerprofilesctl get 2>/dev/null)" && [[ -n "$value" ]]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "unavailable"
    fi
}

read_platform_profile() {
    local value

    if [[ -r "$PLATFORM_PROFILE_PATH" ]] && read -r value < "$PLATFORM_PROFILE_PATH"; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "unavailable"
    fi
}

read_gpu_mode() {
    local value

    if [[ -r "$GPU_MODE_PATH" ]] && read -r value < "$GPU_MODE_PATH"; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "unavailable"
    fi
}

read_desired_mode() {
    local value

    if [[ -r "$DESIRED_FILE" ]] && read -r value < "$DESIRED_FILE"; then
        case "$value" in
            eco|balanced|performance)
                printf '%s\n' "$value"
                return
                ;;
        esac
    fi
    printf '%s\n' "none"
}

read_desired_gpu() {
    local value

    if [[ -r "$DESIRED_GPU_FILE" ]] && read -r value < "$DESIRED_GPU_FILE"; then
        case "$value" in
            hybrid|discrete)
                printf '%s\n' "$value"
                return
                ;;
        esac
    fi
    printf '%s\n' "none"
}

read_firefox_gpu() {
    local value

    if [[ -r "$FIREFOX_GPU_FILE" ]] && read -r value < "$FIREFOX_GPU_FILE"; then
        case "$value" in
            integrated|discrete)
                printf '%s\n' "$value"
                return
                ;;
        esac
    fi
    printf '%s\n' "integrated"
}

firefox_gpu_label() {
    case "$1" in
        integrated) printf '%s\n' "集显" ;;
        discrete) printf '%s\n' "独显" ;;
        none) printf '%s\n' "未设置" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

set_firefox_gpu() {
    local requested="$1"
    local temporary_file

    case "$requested" in
        integrated|discrete) ;;
        *)
            notify_user critical "Firefox 显卡设置失败" "未知选择：${requested}"
            return 2
            ;;
    esac

    mkdir -p "$CONFIG_DIR"
    temporary_file="${FIREFOX_GPU_FILE}.tmp.$$"
    if ! printf '%s\n' "$requested" > "$temporary_file" || ! mv -f "$temporary_file" "$FIREFOX_GPU_FILE"; then
        rm -f "$temporary_file"
        notify_user critical "Firefox 显卡设置失败" "无法写入 ${FIREFOX_GPU_FILE}"
        return 1
    fi

    notify_user normal "Firefox 显卡已设为$(firefox_gpu_label "$requested")" "请完全退出 Firefox 后重新打开；无需重启电脑。"
}

nvidia_output_connected() {
    local status_file
    local status

    for status_file in "$NVIDIA_DRM_PATH"/card*/card*-*/status; do
        [[ -r "$status_file" ]] || continue
        if read -r status < "$status_file" && [[ "$status" == "connected" ]]; then
            return 0
        fi
    done
    return 1
}

mode_from_state() {
    local power_profile="$1"
    local platform_profile="$2"

    case "${power_profile}:${platform_profile}" in
        power-saver:low-power) printf '%s\n' "eco" ;;
        balanced:balanced) printf '%s\n' "balanced" ;;
        performance:balanced-performance|performance:balanced) printf '%s\n' "performance" ;;
        *) printf '%s\n' "mismatch" ;;
    esac
}

mode_label() {
    case "$1" in
        eco) printf '%s\n' "省电" ;;
        balanced) printf '%s\n' "平衡" ;;
        performance) printf '%s\n' "性能" ;;
        none) printf '%s\n' "未设置" ;;
        *) printf '%s\n' "状态不一致" ;;
    esac
}

gpu_label() {
    case "$1" in
        uma) printf '%s\n' "集显 (UMA)" ;;
        hybrid) printf '%s\n' "混合显卡" ;;
        discrete) printf '%s\n' "独显" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

status_json() {
    local power_profile platform_profile gpu_mode desired desired_gpu actual external firefox_gpu
    local text tooltip base_class class_json desired_label

    power_profile="$(read_power_profile)"
    platform_profile="$(read_platform_profile)"
    gpu_mode="$(read_gpu_mode)"
    desired="$(read_desired_mode)"
    desired_gpu="$(read_desired_gpu)"
    firefox_gpu="$(read_firefox_gpu)"
    actual="$(mode_from_state "$power_profile" "$platform_profile")"

    if nvidia_output_connected; then
        external="已连接（依赖 NVIDIA）"
    else
        external="未连接"
    fi

    case "$actual" in
        eco)
            text=""
            base_class="power-saver"
            ;;
        balanced)
            text=""
            base_class="balanced"
            ;;
        performance)
            text="󱐋"
            base_class="performance"
            ;;
        *)
            text=""
            base_class="mismatch"
            ;;
    esac

    class_json="$(jq -cn --arg base "$base_class" '[ $base ]')"
    if [[ -e "$PENDING_REBOOT_FILE" ]]; then
        text="${text} 󰑓"
        class_json="$(jq -cn --arg base "$base_class" '[ $base, "pending" ]')"
        tooltip="当前电源模式：$(mode_label "$actual")\n目标显卡：$(gpu_label "$desired_gpu")（等待重启）\n当前显卡：$(gpu_label "$gpu_mode")\n电源档位：${power_profile}\n固件档位：${platform_profile}\nFirefox（混合模式）：$(firefox_gpu_label "$firefox_gpu")\nNVIDIA 外接屏：${external}\n---\n左键：选择模式\n右键：显示详细状态"
    elif [[ "$desired" != "none" && "$desired" != "$actual" ]]; then
        desired_label="$(mode_label "$desired")"
        text=""
        class_json="$(jq -cn '[ "mismatch" ]')"
        tooltip="电源状态未同步：目标为${desired_label}\n当前模式：$(mode_label "$actual")\n电源档位：${power_profile}\n固件档位：${platform_profile}\n显卡模式：$(gpu_label "$gpu_mode")\nFirefox（混合模式）：$(firefox_gpu_label "$firefox_gpu")\nNVIDIA 外接屏：${external}\n---\n左键：重新选择模式\n右键：显示详细状态"
    elif [[ "$desired_gpu" != "none" && "$desired_gpu" != "$gpu_mode" ]]; then
        text=""
        class_json="$(jq -cn '[ "mismatch" ]')"
        tooltip="显卡状态未同步：目标为$(gpu_label "$desired_gpu")\n当前显卡：$(gpu_label "$gpu_mode")\n当前电源模式：$(mode_label "$actual")\n---\n左键：重新选择显卡模式\n右键：显示详细状态"
    else
        tooltip="当前模式：$(mode_label "$actual")\n电源档位：${power_profile}\n固件档位：${platform_profile}\n显卡模式：$(gpu_label "$gpu_mode")\nFirefox（混合模式）：$(firefox_gpu_label "$firefox_gpu")\nNVIDIA 外接屏：${external}\n---\n左键：选择模式\n右键：显示详细状态"
    fi

    tooltip="${tooltip//\\n/$'\n'}"

    jq -cn \
        --arg text "$text" \
        --arg tooltip "$tooltip" \
        --argjson class "$class_json" \
        '{text: $text, tooltip: $tooltip, class: $class}'
}

target_values() {
    case "$1" in
        eco) printf '%s %s\n' "power-saver" "low-power" ;;
        balanced) printf '%s %s\n' "balanced" "balanced" ;;
        performance) printf '%s %s\n' "performance" "balanced-performance" ;;
        *) return 2 ;;
    esac
}

set_mode() {
    local requested="$1"
    local target_power target_platform previous_power previous_gpu current_platform current_gpu verified_power
    local needs_reboot="no"

    if ! read -r target_power target_platform < <(target_values "$requested"); then
        notify_user critical "无法切换模式" "未知模式：${requested}"
        return 2
    fi

    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        notify_user normal "模式切换正在进行" "请等待当前操作完成。"
        return 1
    fi

    previous_power="$(read_power_profile)"
    current_platform="$(read_platform_profile)"
    current_gpu="$(read_gpu_mode)"
    previous_gpu="$current_gpu"

    if [[ "$previous_power" == "unavailable" ]]; then
        notify_user critical "无法切换模式" "power-profiles-daemon 当前不可用。"
        return 1
    fi
    if [[ "$current_gpu" == "unavailable" ]]; then
        notify_user critical "无法切换模式" "未找到本机的 gpu_mode 固件接口。"
        return 1
    fi

    if ! run_powerprofilesctl set "$target_power"; then
        notify_user critical "电源档位切换失败" "无法设置 ${target_power}，显卡模式未更改。"
        return 1
    fi

    verified_power="unavailable"
    for _ in {1..10}; do
        verified_power="$(read_power_profile)"
        [[ "$verified_power" == "$target_power" ]] && break
        sleep 0.1
    done
    if [[ "$verified_power" != "$target_power" ]]; then
        if [[ "$previous_power" != "unavailable" ]]; then
            run_powerprofilesctl set "$previous_power" >/dev/null 2>&1 || true
        fi
        notify_user critical "电源档位未生效" "后端仍为 ${verified_power}；已停止操作，显卡模式未更改。"
        return 1
    fi

    if [[ ! -x "$ROOT_HELPER" ]]; then
        run_powerprofilesctl set "$previous_power" >/dev/null 2>&1 || true
        notify_user critical "系统模式助手缺失" "未找到 ${ROOT_HELPER}；电源档位已恢复。"
        return 1
    fi

    if ! pkexec "$ROOT_HELPER" "$requested"; then
        run_powerprofilesctl set "$previous_power" >/dev/null 2>&1 || true
        notify_user critical "平台或显卡模式切换失败" "操作已取消或固件拒绝请求；CPU 电源档位已恢复。"
        return 1
    fi

    current_platform="$(read_platform_profile)"
    current_gpu="$(read_gpu_mode)"
    if [[ ( "$current_platform" != "$target_platform" &&
            ( "$requested" != "performance" || "$current_platform" != "balanced" ) ) ||
          "$current_gpu" != "$previous_gpu" ]]; then
        run_powerprofilesctl set "$previous_power" >/dev/null 2>&1 || true
        notify_user critical "系统模式未完整生效" "平台=${current_platform}、GPU=${current_gpu}；CPU 电源档位已恢复。"
        return 1
    fi

    if [[ -e "$PENDING_REBOOT_FILE" ]]; then
        needs_reboot="yes"
    fi

    if [[ "$needs_reboot" == "yes" ]]; then
        notify_user normal "已切换到$(mode_label "$requested")模式" "CPU 与平台档位已生效；显卡切换仍等待重启。"
    elif [[ "$requested" == "performance" && "$current_platform" == "balanced" ]]; then
        notify_user normal "已切换到性能模式" "CPU 性能档已生效；当前供电下固件保持平衡档。"
    else
        notify_user normal "已切换到$(mode_label "$requested")模式" "CPU 与平台档位已生效；显卡模式保持不变。"
    fi
}

set_gpu() {
    local requested="$1"
    local previous_gpu previous_platform current_gpu current_platform

    case "$requested" in
        hybrid|discrete) ;;
        *)
            notify_user critical "显卡切换失败" "未知显卡模式：${requested}"
            return 2
            ;;
    esac

    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        notify_user normal "模式切换正在进行" "请等待当前操作完成。"
        return 1
    fi

    previous_gpu="$(read_gpu_mode)"
    previous_platform="$(read_platform_profile)"
    if [[ "$previous_gpu" == "unavailable" || "$previous_platform" == "unavailable" ]]; then
        notify_user critical "显卡切换失败" "固件状态当前不可用。"
        return 1
    fi
    if [[ "$previous_gpu" == "$requested" && ! -e "$PENDING_REBOOT_FILE" ]]; then
        notify_user normal "显卡模式无需切换" "当前已是$(gpu_label "$requested")。"
        return 0
    fi

    if ! pkexec "$ROOT_HELPER" "gpu-${requested}"; then
        notify_user critical "显卡切换失败" "管理员授权被取消或固件拒绝请求。"
        return 1
    fi

    current_gpu="$(read_gpu_mode)"
    current_platform="$(read_platform_profile)"
    if [[ "$current_platform" != "$previous_platform" ||
          ( "$current_gpu" != "$requested" &&
            ( ! -e "$PENDING_REBOOT_FILE" || "$current_gpu" != "$previous_gpu" ) ) ]]; then
        notify_user critical "显卡状态未同步" "固件档位=${current_platform}，显卡模式=${current_gpu}。"
        return 1
    fi

    if [[ -e "$PENDING_REBOOT_FILE" ]]; then
        notify_user normal "已请求切换到$(gpu_label "$requested")" "重启后显卡模式才会生效；系统不会自动重启。"
    else
        notify_user normal "显卡模式已设为$(gpu_label "$requested")" "无需重启。"
    fi
}

show_menu() {
    local choice selected_gpu gpu_choice

    if [[ -e "$PENDING_REBOOT_FILE" ]]; then
        selected_gpu="$(read_desired_gpu)"
    else
        selected_gpu="$(read_gpu_mode)"
    fi
    if [[ "$selected_gpu" == "discrete" ]]; then
        gpu_choice='显卡｜切回混合显卡（需重启）'
    else
        gpu_choice='显卡｜切到独显模式（需重启）'
    fi

    choice="$(printf '%s\n' \
        '省电｜CPU 与平台省电（无需重启）' \
        "平衡｜CPU 与平台平衡（Firefox：$(firefox_gpu_label "$(read_firefox_gpu)")）" \
        '性能｜CPU 性能优先（无需重启）' \
        "$gpu_choice" \
        | fuzzel --dmenu --prompt='系统模式：' --lines=4 2>/dev/null)" || return 0

    case "$choice" in
        省电*) set_mode eco ;;
        平衡*) show_firefox_menu ;;
        性能*) set_mode performance ;;
        显卡*)
            if [[ "$selected_gpu" == "discrete" ]]; then
                set_gpu hybrid
            else
                set_gpu discrete
            fi
            ;;
    esac
}

show_firefox_menu() {
    local choice current

    current="$(read_firefox_gpu)"
    choice="$(printf '%s\n' \
        "$( [[ "$current" == integrated ]] && printf '✓ ' )Firefox 使用集显｜省电" \
        "$( [[ "$current" == discrete ]] && printf '✓ ' )Firefox 使用独显｜3D/WebGL" \
        '返回' \
        | fuzzel --dmenu --prompt='平衡模式 / Firefox：' --lines=3 2>/dev/null)" || return 0

    case "$choice" in
        *使用集显*)
            if set_mode balanced; then
                set_firefox_gpu integrated
            fi
            ;;
        *使用独显*)
            if set_mode balanced; then
                set_firefox_gpu discrete
            fi
            ;;
    esac
}

show_info() {
    local power_profile platform_profile gpu_mode desired desired_gpu external firefox_gpu
    local message

    power_profile="$(read_power_profile)"
    platform_profile="$(read_platform_profile)"
    gpu_mode="$(read_gpu_mode)"
    desired="$(read_desired_mode)"
    desired_gpu="$(read_desired_gpu)"
    firefox_gpu="$(read_firefox_gpu)"
    if nvidia_output_connected; then
        external="已连接"
    else
        external="未连接"
    fi

    printf -v message '电源档位：%s\n固件档位：%s\n当前显卡：%s\n目标电源模式：%s\n目标显卡：%s\nFirefox（混合模式）：%s\nNVIDIA 外接屏：%s' \
        "$power_profile" "$platform_profile" "$(gpu_label "$gpu_mode")" "$(mode_label "$desired")" "$(gpu_label "$desired_gpu")" "$(firefox_gpu_label "$firefox_gpu")" "$external"
    notify_user normal "系统模式详细状态" "$message"
}

check_setup() {
    local failed=0
    local item

    for item in powerprofilesctl jq fuzzel notify-send flock pkexec; do
        if ! command -v "$item" >/dev/null 2>&1; then
            printf 'missing command: %s\n' "$item" >&2
            failed=1
        fi
    done
    if [[ ! -r "$GPU_MODE_PATH" ]]; then
        printf 'missing gpu mode interface: %s\n' "$GPU_MODE_PATH" >&2
        failed=1
    fi
    if [[ ! -x "$ROOT_HELPER" ]]; then
        printf 'missing root helper: %s\n' "$ROOT_HELPER" >&2
        failed=1
    fi
    if (( failed == 0 )); then
        printf 'holo-power-mode setup: ok\n'
    fi
    return "$failed"
}

case "${1:-status}" in
    status) status_json ;;
    menu) show_menu ;;
    set)
        [[ $# -eq 2 ]] || { printf 'usage: %s set {eco|balanced|performance}\n' "$0" >&2; exit 2; }
        set_mode "$2"
        ;;
    set-gpu)
        [[ $# -eq 2 ]] || { printf 'usage: %s set-gpu {hybrid|discrete}\n' "$0" >&2; exit 2; }
        set_gpu "$2"
        ;;
    set-firefox)
        [[ $# -eq 2 ]] || { printf 'usage: %s set-firefox {integrated|discrete}\n' "$0" >&2; exit 2; }
        set_firefox_gpu "$2"
        ;;
    info) show_info ;;
    check) check_setup ;;
    *)
        printf 'usage: %s {status|menu|set MODE|set-gpu GPU|set-firefox GPU|info|check}\n' "$0" >&2
        exit 2
        ;;
esac
