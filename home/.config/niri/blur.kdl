// --- NIRI BLUR START ---
// 顶层的blur配置，细节调整blur的效果
blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}
// 普通窗口默认不启用模糊；Clavis 按实际可见区域请求效果。
window-rule {
    background-effect {
        xray true
        blur false
    }
}
// 浮动窗口禁用xray可以实时渲染模糊效果但是性能消耗高，开启xray会穿过浮动窗口底下的窗口直接透视到桌面。看个人喜好选择禁用与否吧。
window-rule {
    match is-floating=true
    background-effect {
        xray true
        blur false
    }
}
// fuzzle专属的layer规则
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 8
    background-effect {
        xray false
	blur true
    }
}
// GTK 文件管理器：保持主窗口清晰，只对原生 Wayland 菜单启用毛玻璃。
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    opacity 1.0

    popups {
        geometry-corner-radius 12
        opacity 0.94
        background-effect {
            blur true
            xray false
            saturation 1.0
        }
    }
}
window-rule {
    match app-id=r#"^(thunar|Thunar)$"#
    opacity 1.0
    popups {
        geometry-corner-radius 6
        opacity 0.94
        background-effect {
            blur true
            xray false
            saturation 1.0
        }
    }
}
window-rule {
    match app-id="one.alynx.showmethekey"
    background-effect {
        xray false
        blur false
    }
}

// Kitty redraws small regions frequently (cursor, text and cursor trail).
// Keeping those client-alpha updates on the global xray path can expose the
// wallpaper snapshot for a frame. Preserve Kitty's own background_opacity,
// but bypass compositor-side xray/blur for this window.
window-rule {
    match app-id=r#"^kitty$"#
    background-effect {
        xray false
        blur false
    }
    popups {
        opacity 1.0
        background-effect { xray false; blur false; }
    }
}

// Firefox continuously repaints while scrolling and when link decorations
// change. Keep it off the translucent blur path to avoid background flicker.
window-rule {
    match app-id=r#"firefox$"#
    opacity 1.0
    background-effect {
        blur false
    }
    popups {
        opacity 1.0
        background-effect { xray false; blur false; }
    }
}

// Qt/Avalonia 应用保持菜单文字与输入候选框对比度。
// Fcitx 的嵌入式候选框仍由已修复的 Matugen 主题管理。
window-rule {
    match app-id=r#"^(wechat|v2rayN)$"#
    popups {
        opacity 1.0
        background-effect { xray false; blur false; }
    }
}
// --- NIRI BLUR END ---
