# shellcheck shell=bash disable=SC2034,SC2154
# Generated by scripts/release.py; dependencies come from packaging/dependencies.json.
pkgbase=key-cli
pkgname=('key-cli' 'key-cli-keyboard-access' 'key-cli-cpu-power-access')
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Clavis command interface, system metrics and independent desktop backends'
arch=('x86_64')
url='https://github.com/StatIndet/key-cli'
license=('GPL-3.0-or-later')
makedepends=@MAKEDEPENDS@
checkdepends=@CHECKDEPENDS@
source=("key-cli-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/key-cli-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
    cd "key-cli-${pkgver}" || return
    python -m build --wheel --no-isolation
    cmake -S native -B native/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBEXECDIR=lib -DBUILD_TESTING=ON
    cmake --build native/build
}

check() {
    cd "key-cli-${pkgver}" || return
    PYTHONPATH=src python -m pytest
    python scripts/check-wheel.py dist/*.whl
    ctest --test-dir native/build --output-on-failure --no-tests=error
}

package_key-cli() {
    depends=@KEY_CLI_DEPENDS@
    optdepends=@KEY_CLI_OPTDEPENDS@
    cd "key-cli-${pkgver}" || return
    python -m installer --destdir="${pkgdir}" --prefix=/usr dist/*.whl
    DESTDIR="${pkgdir}" cmake --install native/build
    install -Dm644 systemd/user/clavis-clipboard.service "${pkgdir}/usr/lib/systemd/user/clavis-clipboard.service"
    install -Dm644 completions/key.fish "${pkgdir}/usr/share/fish/vendor_completions.d/key.fish"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli/installation.md"
}

package_key-cli-keyboard-access() {
    pkgdesc='Optional whole evdev keyboard device access for active local users'
    depends=@KEY_CLI_KEYBOARD_ACCESS_DEPENDS@
    cd "key-cli-${pkgver}" || return
    install -Dm644 packaging/udev/71-clavis-keyboard-leds.rules "${pkgdir}/usr/lib/udev/rules.d/71-clavis-keyboard-leds.rules"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli-keyboard-access/installation.md"
}

package_key-cli-cpu-power-access() {
    pkgdesc='Optional CPU energy sensor access for the narrow native helper'
    arch=('any')
    depends=@KEY_CLI_CPU_POWER_ACCESS_DEPENDS@
    install=key-cli-cpu-power-access.install
    cd "key-cli-${pkgver}" || return
    install -Dm755 packaging/arch/key-cli-cpu-power-access.sh "${pkgdir}/usr/lib/key-cli/cpu-power-access"
    install -Dm644 packaging/arch/key-cli-cpu-power-access.hook "${pkgdir}/usr/share/libalpm/hooks/key-cli-cpu-power-access.hook"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli-cpu-power-access/installation.md"
}
